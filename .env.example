# SingAR environment variables.
# Copy this file to `.env` and fill in your real key.
# NEVER commit the real .env — it is gitignored.

# ZenMux API key (https://zenmux.ai). Used by the optional cloud step
# (qwen3-asr-flash re-ASR / Qwen3-Max LLM-polish) and the spike scripts.
ZENMUX_API_KEY=sk-put-your-key-here

# Optional: Alibaba DashScope key, for the direct qwen3-asr-flash-realtime path.
DASHSCOPE_API_KEY=
