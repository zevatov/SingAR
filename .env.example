# SingAR environment variables.
# Copy this file to `.env` and fill in your real key.
# NEVER commit the real .env — it is gitignored.

# ZenMux API key (https://zenmux.ai). Used for the optional LLM-polish cloud step
# (qwen3-max over the local transcript) and the spike scripts.
ZENMUX_API_KEY=sk-put-your-key-here

# OpenRouter API key (https://openrouter.ai). Used for the optional cloud
# re-ASR step: real speech-to-text models (Qwen3 ASR Flash, Whisper Large V3
# Turbo, GPT-4o Mini Transcribe, Voxtral) via the OpenAI-compatible
# /audio/transcriptions endpoint with multipart file upload.
OPENROUTER_API_KEY=

# Optional: Alibaba DashScope key, for the direct qwen3-asr-flash-realtime path.
DASHSCOPE_API_KEY=
